{
  "name": "lumaflow-photo-editor",
  "version": "1.0.0",
  "description": "Professional mobile photo editing application inspired by Adobe Lightroom Mobile, built with React Native, TypeScript, WebGL/GLSL shader pipeline, and SQLite persistence.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "rust:test": "cargo test --release --manifest-path rust-core/Cargo.toml",
    "rust:build": "cargo build --release --manifest-path rust-core/Cargo.toml",
    "rust:android": "powershell -ExecutionPolicy Bypass -File ./scripts/build-rust-android.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-gl": "~57.0.2",
    "expo-image-picker": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
